# ==============================================================================
# StudentAI Environment Variables Template
# Copy this file to .env and insert your real Gemini API key:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Required for Phase 1 embeddings and LLM generation)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Configuration
# Official Google GenAI model: gemini-embedding-2 (GA successor to text-embedding-004)
# Flexible MRL dimensions supported: 768, 1536, 3072 (Default recommended: 768)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Generation Model Configuration
GEMINI_GENERATION_MODEL=gemini-3-flash-preview

# Qdrant Local Persistent Storage Configuration
# Uses embedded Qdrant on local disk (no Docker or cloud connection needed)
QDRANT_STORAGE_PATH=data/qdrant_storage
QDRANT_COLLECTION_NAME=student_knowledge_base

# Chunking Strategy Configuration (Character counts)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Sparse BM25 Index Configuration
SPARSE_INDEX_DIR=data/sparse_index

# Persistent Storage Paths (Set to persistent mount in production, e.g. /var/data/studentai)
USER_DB_PATH=data/users.db
LEARNING_EVENTS_PATH=data/learning/learning_events.json
STUDY_PLANS_PATH=data/learning/study_plans.json
UPLOADS_DIR=data/uploads

# Environment & Server
ENVIRONMENT=development
# Port and host binding for backend
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated exact domains, NO trailing slashes)
# In production, set to your frontend domain: e.g. https://studentai.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Session Security
# Generate a cryptographically secure 32+ byte string: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change-this-in-production-to-a-random-secure-secret-key-32b
AUTH_TOKEN_EXPIRE_HOURS=24

# Cookie Security Configuration
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
# Use 'lax' for same-site / top-level navigation, or 'none' if cross-domain with COOKIE_SECURE=true
COOKIE_SAMESITE=lax
